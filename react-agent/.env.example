TAVILY_API_KEY=...

# To separate your traces from other application
LANGSMITH_PROJECT=react-agent

# Default LLM (ReAct needs tool calling; use deepseek-chat, not deepseek-reasoner)
MODEL=deepseek/deepseek-chat
DEEPSEEK_API_KEY=...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_FAST_MODEL=deepseek-chat
DEEPSEEK_REASONING_MODEL=deepseek-chat

# Alternative LLM providers:
ANTHROPIC_API_KEY=....
FIREWORKS_API_KEY=...
OPENAI_API_KEY=...

# Machine-local TRIBE worker. Not a secret; do not commit the real path in YAML.
TRIBE_PYTHON=/path/to/envs/tribev2/bin/python
