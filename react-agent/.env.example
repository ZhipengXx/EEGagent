TAVILY_API_KEY=

# To separate your traces from other application
LANGSMITH_PROJECT=react-agent

# Default LLM (ReAct needs tool calling; use deepseek-chat, not deepseek-reasoner)
MODEL=deepseek/deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Legacy global compatibility profile; EEG has independent thinking defaults.
# Resolve current version from provider response_model rather than this alias.
DEEPSEEK_FAST_MODEL=deepseek-flash
DEEPSEEK_REASONING_MODEL=deepseek-chat

# Alternative LLM providers:
ANTHROPIC_API_KEY=
FIREWORKS_API_KEY=
OPENAI_API_KEY=

# Machine-local TRIBE worker. Not a secret; do not commit the real path in YAML.
TRIBE_PYTHON=/path/to/envs/tribev2/bin/python
# Set false for direct DeepSeek connections when HTTP(S)_PROXY is unusable.
DEEPSEEK_TRUST_ENV=true

# EEG-only role overrides. CLI > goal.role_models > role env > globals > defaults.
# Full role names (EEG_CANDIDATE_CODER_*) also work. Blank variables are omitted.
# EEG_CODER_MODEL=deepseek-v4-pro
# EEG_CODER_THINKING=true
# EEG_CODER_REASONING_EFFORT=high
# EEG_CODER_MAX_TOKENS=32768
# EEG_CODER_TIMEOUT_S=240
# EEG_REVIEWER_MODEL=deepseek-v4-pro
# EEG_CURATOR_REASONING_EFFORT=low
# EEG_LIBRARIAN_THINKING=false
# Optional deployment-verified prices; without all rate/source/date fields USD is unknown.
# Reasoning tokens are already part of completion tokens, never counted twice.
# DEEPSEEK_USD_INPUT_PER_MILLION=
# DEEPSEEK_USD_OUTPUT_PER_MILLION=
# DEEPSEEK_USD_CACHE_HIT_PER_MILLION=
# DEEPSEEK_PRICE_SOURCE=
# DEEPSEEK_PRICE_DATE=

# EEG role routing (goal/explicit CLI overrides take priority). API keys stay local.
# EEG_CANDIDATE_CODER_MODEL=deepseek-flash
# EEG_CANDIDATE_CODER_THINKING=true
# EEG_CANDIDATE_CODER_REASONING_EFFORT=high
# EEG_CANDIDATE_CODER_MAX_TOKENS=32768
# EEG_CANDIDATE_CODER_TIMEOUT_S=240
# All eight profiles: configs/goals/eeg_screen_then_confirm.yaml

# EEG context protocol: enforce is the default. Shadow records size comparisons
# while still sending only the compiled, measured request. Neither mode permits
# an unbounded legacy FULL fallback.
# EEG_CONTEXT_PROTOCOL=enforce
